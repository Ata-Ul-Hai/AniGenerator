GEMINI_API_KEY=your_key_here
SVG_ASSETS_DIR=../assets/svgs
MAX_SCENES=15
MAX_INPUT_CHARS=200000
MAX_UPLOAD_MB=20
GEMINI_MODEL=gemini-2.5-flash
OUTPUT_DIR=../renderer/public
RUN_RETENTION_COUNT=20

APP_ENV=development
AUTO_CREATE_TABLES=true
RECOVER_STALE_JOBS_ON_STARTUP=true
DATABASE_SSL_MODE=prefer
JOB_WORKER_COUNT=2
JOB_QUEUE_CAPACITY=6
MAX_CONCURRENT_RENDERS=1

ENABLE_AUTH=false
AUTH_USERNAME=admin
AUTH_PASSWORD=change_me
JWT_SECRET=change_me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Local default (SQLite)
DATABASE_URL=sqlite:///./anigen.db

# Docker/Postgres deployment values
POSTGRES_USER=anigen
POSTGRES_PASSWORD=change_me
POSTGRES_DB=anigendb
# DATABASE_URL=postgresql://anigen:change_me@db:5432/anigendb
# Multi-Model Animation Director
USE_MULTI_MODEL_DIRECTOR=false
GROQ_API_KEY=
VISUAL_VALIDATION_THRESHOLD=0.6
LOTTIEFILES_CACHE_TTL_SECONDS=3600
LOTTIEFILES_BASE_URL=https://lottiefiles.com/api